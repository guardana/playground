{
  "apiVersion": "agent-policy/v1alpha1",
  "bundle": {"id": "lab-mode-02", "version": "1", "serial": 1, "maxStaleSeconds": 600},
  "rules": [
    {"id": "diagnostics-allowed", "effect": "ALLOW", "when": {"action": {"name": ["shell.exec"]}}},
    {"id": "listing-allowed", "effect": "ALLOW", "when": {"action": {"name": ["fs.list"]}}},
    {"id": "file-reads-denied", "effect": "DENY", "when": {"action": {"name": ["fs.read"]}}},
    {"id": "exports-need-approval", "effect": "REQUIRE_APPROVAL", "when": {"action": {"name": ["crm.export_table"]}}}
  ]
}
