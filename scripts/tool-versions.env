# The only place a tool version is written. scripts/bootstrap.sh verifies what
# is installed against these; CI installs exactly these.
# Go itself is pinned in go.mod; CI reads it with go-version-file.
#
# Each SHA256 is the release asset bootstrap.sh downloads for that platform,
# taken from the project's published checksums (zizmor publishes none: its
# signed build provenance attestation) and matched against the downloaded bytes.
GOLANGCI_LINT_VERSION=2.13.2
