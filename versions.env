# The systems under test, pinned. Compose files and scenarios refer to these
# variables and never write a name or a version themselves, so an upstream
# rename is one edit here.
#
# Both systems are built in parallel repositories. A test run against "whatever
# is on disk" has measured nothing, so these are the only things the lab talks
# to.

# The enforcement plane: decides one tool call as it is made.
ENFORCER_IMAGE=ghcr.io/guardana/runtime
ENFORCER_TAG=dev
ENFORCER_GATEWAY_BIN=guardana-runtime-gateway
ENFORCER_CONTROL_BIN=guardana-runtime
# Where the lab reads the enforcer's own naming from at run time, so scenarios
# stay free of the product name.
ENFORCER_BRAND_ENDPOINT=/brand

# The verifier: grades a run after it happened.
VERIFIER_PACKAGE=guardana-cli
VERIFIER_VERSION=0.23.0
VERIFIER_CLI=guardana

# Third-party images used by the lab itself. Pinned to a released tag for the
# same reason the systems under test are: a lab that pulls a moving tag cannot
# say which software produced a result.
POSTGRES_IMAGE=postgres:17-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.31.1
ATTACKER_WEB_IMAGE=nginx:1.31.5-alpine
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.140.0
JAEGER_IMAGE=jaegertracing/jaeger:2.12.0
OPA_IMAGE=openpolicyagent/opa:1.11.0

# Base images the lab builds its own services from: the victim tool servers, the
# scripted agent and the stub gateway. The Go version matches go.mod, which is
# where it is decided.
GO_BUILD_IMAGE=golang:1.27.1-alpine3.24
SERVICE_BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot
