# The systems under test, pinned. Compose files, scripts and the runner refer to
# these variables and never write a name or a version themselves, so an upstream
# rename is one edit here. A test in compose/ fails on a variable nothing reads.
#
# Both systems are built in parallel repositories. A test run against "whatever
# is on disk" has measured nothing, so these are the only things the lab talks
# to.

# The enforcement plane: decides one tool call as it is made. It publishes no
# image, so scripts/build-enforcer.sh builds one from `git archive` of this
# commit, taken from the clone ENFORCER_SOURCE names, and tags it with the
# commit. The binaries are the enforcer's command directories of these names.
ENFORCER_COMMIT=e72ebe261af4ca9bb4b683ddedda81bfcc5de906
# The commit's tree (`git rev-parse <commit>^{tree}`): the build refuses a source that is not it.
ENFORCER_TREE=4c1159f7c7142e0eafb56cdf1bca17b9dd5fe890
ENFORCER_IMAGE=playground-enforcer
ENFORCER_GATEWAY_BIN=guardana-gateway
ENFORCER_CONTROL_BIN=guardana-control
# The namespace the enforcer's gateway marks its own answers under, in `_meta`
# as `<namespace>/answer`. The agent retries a held call only on that mark.
ENFORCER_NAMESPACE=guardana.control

# The verifier: grades a run after it happened. Installed from this release
# with every dependency hash-locked in compose/verifier/requirements.lock.
VERIFIER_PACKAGE=guardana-cli
VERIFIER_VERSION=0.26.1
VERIFIER_CLI=guardana
VERIFIER_IMAGE=playground-verifier
PYTHON_IMAGE=python:3.13.15-slim-trixie@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

# Third-party images used by the lab itself. Pinned to a released tag and the
# digest of its multi-arch index, for the same reason the systems under test
# are: a tag can be moved, and a lab that pulls a moving tag cannot say which
# software produced a result. The tag is for people; the digest decides.
MAILPIT_IMAGE=axllent/mailpit:v1.31.1@sha256:98b916bd3c8d61f7633a52d3ea2f58d00620cb01ca57ab59edde68c347a95365
ATTACKER_WEB_IMAGE=nginx:1.31.5-alpine@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3
# The collector the enforcer exports its trail to. The core distribution
# carries the file exporter, which is how the runner reads the trail back
# without a client for the enforcer's own OTLP endpoint.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:0.138.0@sha256:56951db9579bf00d3f32a4e934e19548183a86c14640798502bcd4c225976ea6
# The proxy a chaos scenario routes one victim's answers through, to slow or
# hold them on their way back to the enforcer.
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0@sha256:9378ed52a28bc50edc1350f936f518f31fa95f0d15917d6eb40b8e376d1a214e

# The name every image the lab builds for itself starts with. Compose tags each
# lab-built service with it, so a run in a compose project of its own reuses the
# images the last run built instead of building a new set under its project.
LAB_IMAGE_PREFIX=playground

# Base images the lab builds its own services and the enforcer from, pinned the
# same way. The Go version matches go.mod, which is where it is decided.
GO_BUILD_IMAGE=golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414
SERVICE_BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
